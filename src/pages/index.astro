---
import Layout from '../layouts/Layout.astro';
import GetInvolvedFormEmailJS from '../components/shared/Form/GetInvolvedForm2.astro';
import { getCollection } from 'astro:content';

import { Image } from 'astro:assets';
import HomeHero from '../assets/images/home/home-hero.png';
import WhoWeAre01 from '../assets/images/home/who-we-are-01.png';
import WhoWeAre02 from '../assets/images/home/who-we-are-02.png';
import WhatWeDo01 from '../assets/images/home/what-we-do-01.png';
import WhatWeDo02 from '../assets/images/home/what-we-do-02.png';
import WhatWeDo03 from '../assets/images/home/what-we-do-03.png';
import WhatWeDo04 from '../assets/images/home/what-we-do-04.png';
import WhatWeDo05 from '../assets/images/home/what-we-do-05.png';
import WhatWeDo06 from '../assets/images/home/what-we-do-06.png';
import LatestNews from '../assets/images/home/latest-news.png';

// Phosphor icons
import GraduationCap from 'phosphor-astro/GraduationCap.astro';
import ChatsTeardrop from 'phosphor-astro/ChatsTeardrop.astro';
import SpeakerHigh from 'phosphor-astro/SpeakerHigh.astro';
import Handshake from 'phosphor-astro/Handshake.astro';
import SealCheck from 'phosphor-astro/SealCheck.astro';

import { t, type Lang } from '../i18n/get';

const baseUrl = import.meta.env.BASE_URL;

// Detect current language from URL
const currentPath = Astro.url.pathname;

const relativePath = currentPath.startsWith(baseUrl)
  ? currentPath.slice(baseUrl.length)
  : currentPath;

const lang: Lang =
  relativePath.startsWith('es/') || relativePath.startsWith('es')
    ? 'es'
    : 'en';

const pages = await getCollection('page');

const home = pages.find(
  (entry) =>
    entry.data.language === 'en' &&
    entry.data.page === 'home'
);


const homeData = lang === 'en' ? home?.data : undefined;

const aboutUs = `${baseUrl}${lang === 'es' ? 'es/' : ''}about`;
const whatWeDo = `${baseUrl}${lang === 'es' ? 'es/' : ''}what-we-do`;
const latestUpdates = `${baseUrl}${lang === 'es' ? 'es/' : ''}latest-updates`;
---

<script>
  import '@momentum-design/components/dist/components/button/index.js';
  import '@momentum-design/components/dist/components/buttonlink/index.js';
  import '@momentum-design/components/dist/components/card/index.js';
  import '@momentum-design/components/dist/components/input/index.js';
  import '@momentum-design/components/dist/components/icon/index.js';
  import '@momentum-design/components/dist/components/text/index.js';
</script>

<Layout title={t(lang, 'main.title')}>
  <!-- Hero -->
  <section class="section hero">
    <div class="inner-container">
      <h1 set:html={homeData?.heroTitle ?? t(lang, 'hero.title')} />

      <p>
        {homeData?.heroSubtitle ?? t(lang, 'hero.subtitle')}

        <mdc-buttonlink
          size="40"
          href={aboutUs}
          rel="noopener noreferrer"
        >
          {homeData?.heroCta ?? t(lang, 'hero.cta')}
        </mdc-buttonlink>
      </p>

      <Image
        src={HomeHero}
        alt={t(lang, 'hero.imageAlt')}
      />
    </div>
  </section>

  <!-- Who we are -->
  <section class="section who-we-are">
    <div class="inner-container overview">
      <div class="section-left">
        <div class="section-title">
          <h2 class="pre-header">
            {homeData?.whoWeAreTag ?? t(lang, 'whoWeAre.tag')}
          </h2>

          <p class="sub-header">
            {homeData?.whoWeAreHeading ?? t(lang, 'whoWeAre.heading')}
          </p>
        </div>

        <p>
          {homeData?.whoWeAreDescription1 ??
            t(lang, 'whoWeAre.description1')}
        </p>

        <p>
          {homeData?.whoWeAreDescription2 ??
            t(lang, 'whoWeAre.description2')}

          <mdc-buttonlink
            size="40"
            href={whatWeDo}
            rel="noopener noreferrer"
          >
            {homeData?.whoWeAreCta ?? t(lang, 'whoWeAre.cta')}
          </mdc-buttonlink>
        </p>
      </div>

      <div class="section-right">
        <Image
          src={WhoWeAre01}
          alt={
            homeData?.whoWeAreImageAlt1 ??
            t(lang, 'whoWeAre.imageAlt1')
          }
        />

        <Image
          src={WhoWeAre02}
          alt={
            homeData?.whoWeAreImageAlt2 ??
            t(lang, 'whoWeAre.imageAlt2')
          }
        />
      </div>
    </div>

    <div class="inner-container who-we-are-card-list">
      <div class="card-list">
        <ul>
          <li>
            <div class="card-icon">
              <GraduationCap class="icon" />
            </div>
           <h3 class="card-list-title">
          {lang === 'en'
            ? home?.data.educationTitle
            : t(lang, 'values.education.title')}
        </h3>

        <p>
          {lang === 'en'
            ? home?.data.educationDescription
            : t(lang, 'values.education.description')}
        </p>
          </li>

          <li>
            <div class="card-icon">
              <ChatsTeardrop class="icon" />
            </div>
            <h3 class="card-list-title">
              {t(lang, 'values.communication.title')}
            </h3>
            <p>{t(lang, 'values.communication.description')}</p>
          </li>

          <li>
            <div class="card-icon">
              <SpeakerHigh class="icon" />
            </div>
            <h3 class="card-list-title">
              {t(lang, 'values.advocacy.title')}
            </h3>
            <p>{t(lang, 'values.advocacy.description')}</p>
          </li>

          <li>
            <div class="card-icon">
              <Handshake class="icon" />
            </div>
            <h3 class="card-list-title">
              {t(lang, 'values.collaboration.title')}
            </h3>
            <p>{t(lang, 'values.collaboration.description')}</p>
          </li>

          <li>
            <div class="card-icon">
              <SealCheck class="icon" />
            </div>
            <h3 class="card-list-title">
              {t(lang, 'values.oversight.title')}
            </h3>
            <p>{t(lang, 'values.oversight.description')}</p>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- What we do -->
  <section class="section secondary what-we-do">
    <div class="inner-container">
      <div class="section-title">
       <h2 class="pre-header">
         {lang === 'en'
    ? home?.data.programsTag
    : t(lang, 'nav.whatWeDo')}
      </h2>

      <p class="sub-header">
        {lang === 'en'
          ? home?.data.programsHeading
          : t(lang, 'programs.heading')}
      </p>
      </div>

      <div class="card-list">
        <ul>
          <li>
            <Image
              src={WhatWeDo01}
              alt={t(lang, 'programs.cafa.imageAlt')}
            />
            <div class="card-list-content">
             <h3 class="card-list-title">
          {lang === 'en'
            ? home?.data.cafaTitle
            : t(lang, 'programs.cafa.title')}
        </h3>

        <p>
          {lang === 'en'
            ? home?.data.cafaDescription
            : t(lang, 'programs.cafa.description')}
        </p>
            </div>
          </li>

          <li>
            <Image
              src={WhatWeDo02}
              alt={t(lang, 'programs.publicDefender.imageAlt')}
            />
            <div class="card-list-content">
             <h3 class="card-list-title">
          {lang === 'en'
            ? home?.data.publicDefenderTitle
            : t(lang, 'programs.publicDefender.title')}
        </h3>

        <p>
          {lang === 'en'
            ? home?.data.publicDefenderDescription
            : t(lang, 'programs.publicDefender.description')}
        </p>
            </div>
          </li>

          <li>
            <Image
              src={WhatWeDo03}
              alt={t(lang, 'programs.policeOversight.imageAlt')}
            />
            <div class="card-list-content">
             <h3 class="card-list-title">
            {lang === 'en'
              ? home?.data.policeOversightTitle
              : t(lang, 'programs.policeOversight.title')}
          </h3>

          <p>
            {lang === 'en'
              ? home?.data.policeOversightDescription
              : t(lang, 'programs.policeOversight.description')}
          </p>
            </div>
          </li>

          <li>
            <Image
              src={WhatWeDo04}
              alt={t(lang, 'programs.earlyCaseReview.imageAlt')}
            />
            <div class="card-list-content">
            <h3 class="card-list-title">
  {lang === 'en'
    ? home?.data.earlyCaseReviewTitle
    : t(lang, 'programs.earlyCaseReview.title')}
</h3>

<p>
  {lang === 'en'
    ? home?.data.earlyCaseReviewDescription
    : t(lang, 'programs.earlyCaseReview.description')}
</p>
            </div>
          </li>

          <li>
            <Image
              src={WhatWeDo05}
              alt={t(lang, 'programs.communityPower.imageAlt')}
            />
            <div class="card-list-content">
              <h3 class="card-list-title">
  {lang === 'en'
    ? home?.data.communityPowerTitle
    : t(lang, 'programs.communityPower.title')}
</h3>

<p>
  {lang === 'en'
    ? home?.data.communityPowerDescription
    : t(lang, 'programs.communityPower.description')}
</p>
            </div>
          </li>

          <li>
            <Image
              src={WhatWeDo06}
              alt={t(lang, 'programs.rightsEducation.imageAlt')}
            />
            <div class="card-list-content">
 <h3 class="card-list-title">
  {lang === 'en'
    ? home?.data.rightsEducationTitle
    : t(lang, 'programs.rightsEducation.title')}
</h3>

<p>
  {lang === 'en'
    ? home?.data.rightsEducationDescription
    : t(lang, 'programs.rightsEducation.description')}
</p>
            </div>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Latest Updates -->
  <section class="section latest-news">
    <div class="inner-container">
      <div class="left">
        <h2>
  {lang === 'en'
    ? home?.data.newsHeading
    : t(lang, 'news.heading')}
</h2>

<p>
  {lang === 'en'
    ? home?.data.newsDescription1
    : t(lang, 'news.description1')}
</p>

<p>
  {lang === 'en'
    ? home?.data.newsDescription2
    : t(lang, 'news.description2')}

  <mdc-buttonlink
    size="40"
    href={latestUpdates}
    rel="noopener noreferrer"
  >
    {lang === 'en'
      ? home?.data.newsCta
      : t(lang, 'news.cta')}
  </mdc-buttonlink>
</p>
      </div>

      <div class="right">
      <Image
  src={LatestNews}
  alt={
    lang === 'en'
      ? home?.data.newsImageAlt
      : t(lang, 'news.imageAlt')
  }
/>
      </div>
    </div>
  </section>

  <!-- Contact / Get Involved Form -->
  <section class="section secondary contact">
    <div class="inner-container">
      <div class="contact-home">
        <h2>{t(lang, 'form.title')}</h2>
        <GetInvolvedFormEmailJS lang={lang} />
      </div>
    </div>
  </section>
</Layout>