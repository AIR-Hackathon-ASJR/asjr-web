---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

// Images
import { Image } from 'astro:assets';
import WhatWeDo01 from '../assets/images/what-we-do/what-we-do-01.png';
import WhatWeDo02 from '../assets/images/what-we-do/what-we-do-02.png';
import WhatWeDo03 from '../assets/images/what-we-do/what-we-do-03.png';
import WhatWeDo04 from '../assets/images/what-we-do/what-we-do-04.png';
import WhatWeDo05 from '../assets/images/what-we-do/what-we-do-05.png';
import WhatWeDo06 from '../assets/images/what-we-do/what-we-do-06.png';

import { t, type Lang } from '../i18n/get';

const baseUrl = import.meta.env.BASE_URL;

// Detect current language from URL
const currentPath = Astro.url.pathname;

const relativePath = currentPath.startsWith(baseUrl)
  ? currentPath.slice(baseUrl.length)
  : currentPath;

const lang: Lang =
  relativePath.startsWith('es/') || relativePath.startsWith('es')
    ? 'es'
    : 'en';

const pages = await getCollection('page');

const ourWork = pages.find(
  (entry) =>
    entry.data.language === 'en' &&
    entry.data.page === 'our-work'
);

const ourWorkData = lang === 'en' ? ourWork?.data : undefined;
---

<Layout
  title={ourWorkData?.pageTitle ?? t(lang, 'whatWeDo.pageTitle')}
>
  <section class="section what-we-do-index">
    <div class="inner-container">
      <h1>
        {ourWorkData?.title ?? t(lang, 'whatWeDo.title')}
      </h1>

      <p>
        {ourWorkData?.description ?? t(lang, 'whatWeDo.description')}
      </p>

      <!-- Card List -->
      <div class="card-list">
        <ul>
          <li>
            <Image
              src={WhatWeDo01}
              alt={
                ourWorkData?.counselImageAlt ??
                t(lang, 'whatWeDo.counsel.imageAlt')
              }
            />

            <div class="card-list-content">
              <h2 class="card-list-title">
                {ourWorkData?.counselTitle ??
                  t(lang, 'whatWeDo.counsel.title')}
              </h2>

              <p>
                {ourWorkData?.counselDescription ??
                  t(lang, 'whatWeDo.counsel.description')}
              </p>
            </div>
          </li>

          <li>
            <Image
              src={WhatWeDo02}
              alt={
                ourWorkData?.officeImageAlt ??
                t(lang, 'whatWeDo.office.imageAlt')
              }
            />

            <div class="card-list-content">
              <h2 class="card-list-title">
                {ourWorkData?.officeTitle ??
                  t(lang, 'whatWeDo.office.title')}
              </h2>

              <p>
                {ourWorkData?.officeDescription ??
                  t(lang, 'whatWeDo.office.description')}
              </p>
            </div>
          </li>

          <li>
            <Image
              src={WhatWeDo03}
              alt={
                ourWorkData?.dismissalImageAlt ??
                t(lang, 'whatWeDo.dismissal.imageAlt')
              }
            />

            <div class="card-list-content">
              <h2 class="card-list-title">
                {ourWorkData?.dismissalTitle ??
                  t(lang, 'whatWeDo.dismissal.title')}
              </h2>

              <p>
                {ourWorkData?.dismissalDescription ??
                  t(lang, 'whatWeDo.dismissal.description')}
              </p>
            </div>
          </li>

          <li>
            <Image
              src={WhatWeDo04}
              alt={
                ourWorkData?.communityImageAlt ??
                t(lang, 'whatWeDo.community.imageAlt')
              }
            />

            <div class="card-list-content">
              <h2 class="card-list-title">
                {ourWorkData?.communityTitle ??
                  t(lang, 'whatWeDo.community.title')}
              </h2>

              <p>
                {ourWorkData?.communityDescription ??
                  t(lang, 'whatWeDo.community.description')}
              </p>
            </div>
          </li>

          <li>
            <Image
              src={WhatWeDo05}
              alt={
                ourWorkData?.publicDefendersImageAlt ??
                t(lang, 'whatWeDo.publicDefenders.imageAlt')
              }
            />

            <div class="card-list-content">
              <h2 class="card-list-title">
                {ourWorkData?.publicDefendersTitle ??
                  t(lang, 'whatWeDo.publicDefenders.title')}
              </h2>

              <p>
                {ourWorkData?.publicDefendersDescription ??
                  t(lang, 'whatWeDo.publicDefenders.description')}
              </p>
            </div>
          </li>

          <li>
            <Image
              src={WhatWeDo06}
              alt={
                ourWorkData?.rightsEducationImageAlt ??
                t(lang, 'whatWeDo.rightsEducation.imageAlt')
              }
            />

            <div class="card-list-content">
              <h2 class="card-list-title">
                {ourWorkData?.rightsEducationTitle ??
                  t(lang, 'whatWeDo.rightsEducation.title')}
              </h2>

              <p>
                {ourWorkData?.rightsEducationDescription ??
                  t(lang, 'whatWeDo.rightsEducation.description')}
              </p>
            </div>
          </li>
        </ul>
      </div>
    </div>
  </section>
</Layout>

<script>
  import '@momentum-design/components/dist/components/text/index.js';
  import '@momentum-design/components/dist/components/card/index.js';
  import '@momentum-design/components/dist/components/button/index.js';
</script>